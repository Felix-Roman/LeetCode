Here is my C# solution for the First Unique Character In A String question on LeetCode!

public class Solution {
    public int FirstUniqChar(string s) {
        Dictionary<char, int> seen = new Dictionary<char, int>();
        
        for(int i = 0; i < s.Length; i++)
        {
            char check = s[i];
            
            if(!seen.ContainsKey(check))
            {
                seen.Add(check, 1);
            }
            else
            {
                seen[check]++; 
            }
        }
        
        for(int i = 0; i < s.Length; i++)
        {
            if(seen[s[i]] == 1)
            {
                return i;
            }
            
        }
        return -1;
    }
}
