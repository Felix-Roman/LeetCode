Here is my C# solution for the String to Integer (atoi) on LeetCode!

public class Solution {
    public int MyAtoi(string s) {
        int i = 0;
        int sign = 1;
        long result = 0;
        
        while(i < s.Length && s[i] == ' ')
        {
            i++;
        }
        
        if(i < s.Length && (s[i] == '-'|| s[i] == '+'))
        {
            if(s[i] == '-')
            {
                sign = -1;
            }
            
            i++;
        }
        
        while(i < s.Length && char.IsDigit(s[i]))
        {
            int digit = s[i] - '0';
            
            if(result > int.MaxValue / 10)
            {
                if(sign == 1)
                {
                    return int.MaxValue;
                }
                else
                {
                    return int.MinValue;
                }
            }
            if(result == int.MaxValue / 10)
            {
                if(sign == 1 && digit > 7)
                {
                    return int.MaxValue;
                }
                if(sign == -1 && digit > 8)
                {
                    return int.MinValue;
                }
            }
            
            result = result * 10 + digit;
            
            i++;
        }
        
        return (int)(result * sign);
    }
}
