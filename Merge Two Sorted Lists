Here is my C# solution for the Merge Two Sorted Lists question on LeetCode!

/**
 * Definition for singly-linked list.
 * public class ListNode {
 *     public int val;
 *     public ListNode next;
 *     public ListNode(int val=0, ListNode next=null) {
 *         this.val = val;
 *         this.next = next;
 *     }
 * }
 */
public class Solution {
    public ListNode MergeTwoLists(ListNode list1, ListNode list2) {
        ListNode start;
        ListNode merge;
        
        if(list1 == null)
        {
            return list2;
        }
        if(list2 == null)
        {
            return list1;
        }
        
        if(list1.val < list2.val)
        {
            start = list1;
            merge = list1;
            list1 = list1.next;
        }
        else
        {
           start = list2;
           merge = list2;
           list2 = list2.next;
        }
        
        while(list1 != null && list2 != null)
        {
            if(list1.val <= list2.val)
            {
               merge.next = list1;
               merge = merge.next;
               list1 = list1.next;
            }
            else
            {
                merge.next = list2;
                merge = merge.next;
                list2 = list2.next;
            }
        }
        
        if(list1 == null)
        {
            merge.next = list2;
        }
        if(list2 == null)
        {
            merge.next = list1;
        }
        
        return start;
    }
}
