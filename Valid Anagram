Here is my C# solution for the Valid Anagram question on LeetCode!

public class Solution {
    public bool IsAnagram(string s, string t) {
        if (s.Length != t.Length)
        {
            return false;
        }

        Dictionary<char, int> seen = new Dictionary<char, int>();

        foreach (char c in s)
        {
            if (seen.ContainsKey(c))
            {
                seen[c]++;
            }
            else
            {
                seen[c] = 1;
            }
        }

        foreach (char c in t)
        {
            if (!seen.ContainsKey(c))
            {
                return false;
            }

            seen[c]--;

            if (seen[c] < 0)
            {
                return false;
            }
        }

        return true;
    }
}
