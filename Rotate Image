Here is my C# solution for the Rotate Image probelm on LeetCode!

public class Solution {
    public void Rotate(int[][] matrix) {
        int n = matrix.Length;
        
        for(int r = 0; r < n; r++)
        {
            for(int c = r + 1; c < n; c++)
            {
                int temp = matrix[r][c];
                matrix[r][c] = matrix[c][r];
                matrix[c][r] = temp;
            }
        }
        
        for(int r = 0; r < n; r++)
        {
            int left = 0;
            int right = n - 1;
            
            while(left < right)
            {
                int temp = matrix[r][left];
                matrix[r][left] = matrix[r][right];
                matrix[r][right] = temp;
                left++;
                right--;
            }
        }
    }
}
